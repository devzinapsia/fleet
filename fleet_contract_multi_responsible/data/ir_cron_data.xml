<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_contract_expiry_notice" model="ir.cron">
            <field name="name">Fleet: send contract expiry notice emails</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_notices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 10:00 UTC = 07:00 in Argentina -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
